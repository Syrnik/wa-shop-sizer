<?xml version="1.0"?>
<psalm
    errorLevel="4"
    phpVersion="7.4"
    resolveFromConfigFile="true"
    cacheDirectory="tests/.psalm-cache-74"
    allFunctionsGlobal="true"
    findUnusedCode="false"
    findUnusedBaselineEntry="false"
    errorBaseline="psalm-baseline.xml"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    autoloader="tests/psalm-init.php"
>
    <projectFiles>
        <directory name="lib" />
    </projectFiles>
    <extraFiles>
        <directory name="../../../../wa-apps" />
        <directory name="../../../../wa-system" />
        <directory name="../../../../wa-config" />
        <directory name="../../../../wa-plugins" />
    </extraFiles>
    <issueHandlers>
        <MissingOverrideAttribute errorLevel="suppress" />
        <ClassMustBeFinal errorLevel="suppress" />
    </issueHandlers>
</psalm>
